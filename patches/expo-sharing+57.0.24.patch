+package expo.modules.sharing;
+
+import java.util.ArrayDeque;
+
+/** Bounded FIFO whose generation makes compare-and-ack safe for identical shares. */
+public final class ShareIntentQueue<T> {
+  public static final class Item<T> {
+    public final String generation;
+    public final T payload;
+    Item(String generation, T payload) { this.generation = generation; this.payload = payload; }
+  }
+  private final int capacity;
+  private final ArrayDeque<Item<T>> items = new ArrayDeque<>();
+  private long nextGeneration = 0L;
+  private int rejected = 0;
+
+  public ShareIntentQueue(int capacity) {
+    if (capacity <= 0) throw new IllegalArgumentException("capacity must be positive");
+    this.capacity = capacity;
+  }
+  public synchronized boolean offer(T payload) {
+    if (payload == null) throw new IllegalArgumentException("payload is required");
+    if (items.size() >= capacity) { if (rejected < Integer.MAX_VALUE) rejected++; return false; }
+    items.addLast(new Item<>(Long.toString(++nextGeneration), payload));
+    return true;
+  }
+  public synchronized Item<T> peek() { return items.peekFirst(); }
+  public synchronized boolean acknowledge(String generation) {
+    Item<T> head = items.peekFirst();
+    if (head == null || generation == null || !head.generation.equals(generation)) return false;
+    items.removeFirst();
+    return true;
+  }
+  public synchronized int takeRejectedWhenEmpty() {
+    if (!items.isEmpty()) return 0;
+    int count = rejected;
+    rejected = 0;
+    return count;
+  }
+}
