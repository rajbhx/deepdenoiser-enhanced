{
  "name": "deepdenoiser",
  "main": "expo-router/entry",
  "version": "2.0.4",
  "onnxruntimeExtensionsEnabled": "false",
  "scripts": {
    "start": "bunx expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint src",
    "build:prod": "eas build -p android --profile production --local",
    "build:store": "eas build -p android --profile playstore --local",
    "build:dev": "eas build -p android --profile development --local",
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit",
    "test:real-model": "node tests/real-model.test.cjs && node tests/real-preallocation.test.cjs",
    "test:document-picker": "node tests/documentPicker.test.cjs",
    "test": "node tests/diagnostics.test.cjs && node tests/diagnostics-ui.test.cjs && node tests/pcm-integrity.test.cjs && node tests/documentPicker.test.cjs && node tests/resampler.test.cjs && node tests/stream-optimization.test.cjs && node tests/quality-safe-frame.test.cjs && node tests/icon-bundle.test.cjs && node tests/dependency-security.test.cjs && node tests/queue-and-compare.test.cjs && node tests/storage-and-processing.test.cjs && node tests/settings-and-model.test.cjs && node tests/pipeline.test.cjs && node tests/recording-safety.test.cjs && node tests/export-and-history.test.cjs && node tests/signing-config.test.cjs && node tests/native-source-contract.test.cjs && node tests/ux-logic.test.cjs && node tests/ui-regression.test.cjs && node tests/share-lifecycle.test.cjs"
  },
  "dependencies": {
    "@expo/ui": "~57.0.11",
    "@expo/vector-icons": "^15.0.3",
    "@siteed/audio-studio": "3.2.0",
    "expo": "^57.0.9",
    "expo-asset": "~57.0.12",
    "expo-audio": "~57.0.3",
    "expo-build-properties": "~57.0.12",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.12",
    "expo-document-picker": "57.0.3",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.6",
    "expo-media-library": "~57.0.4",
    "expo-router": "~57.0.14",
    "expo-sharing": "~57.0.13",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-video": "~57.0.2",
    "onnxruntime-react-native": "^1.24.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.1",
    "expo-dev-client": "~57.0.13",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-document-picker",
          "expo-file-system",
          "expo-sharing"
        ]
      }
    }
  }
}
